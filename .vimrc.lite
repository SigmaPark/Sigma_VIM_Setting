" ===== Lightweight profile for low-end / slow devices =====
" A trimmed variant of .vimrc for machines where smooth animation stutters
" (e.g. a tablet terminal over proot). Drops comfortable-motion so scrolling
" is instant instead of animated, and enables redraw hints. IntelliSense
" (coc.nvim + clangd) is kept intact.
"
" Usage on a slow device:
"   cp .vimrc.lite ~/.vimrc      " or: vim -u /path/to/.vimrc.lite

if has("syntax")
	syntax on
endif

set ts=4                " Tab width
set shiftwidth=4        " Auto indentation tab width
set hlsearch            " Highlight search matches
set number              " Line numbers
set ttyfast             " Assume a fast terminal (smoother redraw)
set lazyredraw          " Don't redraw mid-macro/scroll (less flicker)

"==== Vundle ===="
set nocompatible
filetype off
set rtp+=~/.vim/bundle/Vundle.vim
call vundle#begin()
	Plugin 'VundleVim/Vundle.vim'
	Plugin 'scrooloose/nerdtree'
	Plugin 'vim-airline/vim-airline'
	Plugin 'neoclide/coc.nvim', {'branch': 'release'}
	Plugin 'bfrg/vim-cpp-modern'
	Plugin 'morhetz/gruvbox'
call vundle#end()
filetype plugin indent on

" NerdTree
nmap nerd :NERDTreeToggle<cr>

" Vim-airline (plain fonts — no powerline glyphs, lighter and font-agnostic)
let g:airline_powerline_fonts = 0
let g:airline#extensions#tabline#enabled = 1

" coc.nvim
set hidden
set updatetime=300
set shortmess+=c

" Tab completion
inoremap <silent><expr> <TAB>
      \ coc#pum#visible() ? coc#pum#next(1) :
      \ CheckBackspace() ? "\<Tab>" :
      \ coc#refresh()
inoremap <expr><S-TAB> coc#pum#visible() ? coc#pum#prev(1) : "\<C-h>"

function! CheckBackspace() abort
  let col = col('.') - 1
  return !col || getline('.')[col - 1]  =~# '\s'
endfunction

" Enter selection
inoremap <silent><expr> <CR> coc#pum#visible() ? coc#pum#confirm()
                              \: "\<C-g>u\<CR>\<c-r>=coc#on_enter()\<CR>"

" Diagnostics / navigation
nmap <silent> [g <Plug>(coc-diagnostic-prev)
nmap <silent> ]g <Plug>(coc-diagnostic-next)
nmap <silent> gd <Plug>(coc-definition)
nmap <silent> gy <Plug>(coc-type-definition)
nmap <silent> gi <Plug>(coc-implementation)
nmap <silent> gr <Plug>(coc-references)
nmap <leader>rn <Plug>(coc-rename)

" Vim-cpp-modern
let g:cpp_simple_highlight = 1
let g:cpp_named_requirements_highlight = 1

" Colorscheme
set background=dark
silent! colorscheme gruvbox
