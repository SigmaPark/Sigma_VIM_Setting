" ===== Lightweight profile for low-end / slow devices =====
" A trimmed variant of .vimrc: keeps comfortable-motion (measured smooth on a
" tablet terminal over proot, see NOTE below) but adds ttyfast/lazyredraw.
" IntelliSense (coc.nvim + clangd) is kept intact.
"
" Usage on a slow device:
"   sh sync.sh lite      " or: vim -u /path/to/.vimrc.lite

" NOTE on terminal scrolling: a VERTICAL split (:vs) makes vim give up the
" terminal's hardware scroll. Scroll regions are row ranges only, so with two
" windows side by side vim must repaint every affected cell instead of sending
" one scroll escape. On a 240x89 terminal that is ~21k cells per scroll step,
" and it is by far the biggest cause of sluggish scrolling — not
" comfortable-motion, which was measured smooth once :vs is avoided. Horizontal
" splits (:sp) and tabs (gt) keep the full width and stay fast.

" ---- Encoding: read UTF-8 first, fall back to CP949 for legacy Korean files ----
" Do NOT set 'fileencoding' here: that would silently rewrite every saved file
" as UTF-8 and corrupt CP949 sources.
set encoding=utf-8
set fileencodings=ucs-bom,utf-8,cp949,latin1

if has("syntax")
	syntax on
endif

set ts=4                " Tab width
set shiftwidth=4        " Auto indentation tab width
set hlsearch            " Highlight search matches
set number              " Line numbers
set ttyfast             " Assume a fast terminal (smoother redraw)
set lazyredraw          " Don't redraw mid-macro/scroll (less flicker)

"==== Vundle ===="
set nocompatible
filetype off
set rtp+=~/.vim/bundle/Vundle.vim
call vundle#begin()
	Plugin 'VundleVim/Vundle.vim'
	Plugin 'scrooloose/nerdtree'
	Plugin 'yuttie/comfortable-motion.vim'
	Plugin 'vim-airline/vim-airline'
	Plugin 'neoclide/coc.nvim', {'pinned': 1}	" Vundle cannot pick a branch;
							" clone the release branch by hand (see README)
	Plugin 'bfrg/vim-cpp-modern'
	Plugin 'morhetz/gruvbox'
call vundle#end()
filetype plugin indent on

" NerdTree
nnoremap <F3> :NERDTreeToggle<cr>
let g:NERDTreeWinSize = 60 " generous width for long variable/file names

" GUI font
if has('gui_running')
	set guifont=D2Coding\ 11
endif

" Vim-airline (plain fonts — no powerline glyphs, lighter and font-agnostic)
let g:airline_powerline_fonts = 0
let g:airline#extensions#tabline#enabled = 1
let g:airline#extensions#tabline#buffer_nr_show = 1

" Buffer navigation (cycle files in the focused split, splits stay put)
nnoremap <silent> ]b :bnext<CR>
nnoremap <silent> [b :bprevious<CR>

" comfortable-motion (smooth scroll) — default keys: <C-d>/<C-u>/<C-f>/<C-b>
" friction is a constant deceleration, air_drag is velocity-proportional;
" raised both from the plugin defaults (80.0 / 2.0) to cut the low-speed
" drag tail short instead of gliding to a stop.
let g:comfortable_motion_friction = 140.0
let g:comfortable_motion_air_drag = 5.0

" coc.nvim
set hidden
set updatetime=300
set shortmess+=c

" Tab completion
inoremap <silent><expr> <TAB>
      \ coc#pum#visible() ? coc#pum#next(1) :
      \ CheckBackspace() ? "\<Tab>" :
      \ coc#refresh()
inoremap <expr><S-TAB> coc#pum#visible() ? coc#pum#prev(1) : "\<C-h>"

function! CheckBackspace() abort
  let col = col('.') - 1
  return !col || getline('.')[col - 1]  =~# '\s'
endfunction

" Enter selection
inoremap <silent><expr> <CR> coc#pum#visible() ? coc#pum#confirm()
                              \: "\<C-g>u\<CR>\<c-r>=coc#on_enter()\<CR>"

" Diagnostics / navigation
nmap <silent> [g <Plug>(coc-diagnostic-prev)
nmap <silent> ]g <Plug>(coc-diagnostic-next)
nmap <silent> gd <Plug>(coc-definition)
nmap <silent> gy <Plug>(coc-type-definition)
nmap <silent> gi <Plug>(coc-implementation)
nmap <silent> gr <Plug>(coc-references)
nmap <leader>rn <Plug>(coc-rename)

" Vim-cpp-modern
let g:cpp_simple_highlight = 1
let g:cpp_named_requirements_highlight = 1

" Colorscheme
set background=dark
silent! colorscheme gruvbox

" ---- Session persistence ----
" `vim` with no file args restores the previous session; any other
" invocation (vim file.cpp, etc.) leaves the argument list alone. The
" session is refreshed on every exit so the next bare launch resumes here.
set sessionoptions-=options
let g:session_file = expand('$HOME/.vim/session.vim')

function! s:RestoreSession() abort
	if argc() == 0 && filereadable(g:session_file)
		execute 'source ' . fnameescape(g:session_file)
	endif
endfunction

function! s:SaveSession() abort
	execute 'mksession! ' . fnameescape(g:session_file)
endfunction

augroup AutoSession
	autocmd!
	autocmd VimEnter * nested call s:RestoreSession()
	autocmd VimLeave * call s:SaveSession()
augroup END
